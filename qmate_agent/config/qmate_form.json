{
  "_説明": "Q-mate 管理画面の操作設定。セレクタは実際の画面に合わせて書き換える（README の『セレクタの調べ方』参照）。",
  "base_url": "https://（Q-mate管理画面のURL）",
  "login": {
    "url": "https://（ログインページのURL）",
    "id_selector": "input[name='login_id']",
    "password_selector": "input[name='password']",
    "submit_selector": "button[type='submit']",
    "logged_in_selector": "text=ログアウト"
  },
  "new_job_url": "https://（求人新規作成ページのURL）",
  "fields": [
    {
      "key": "job_no",
      "selector": "input[name='job_no']",
      "action": "fill"
    },
    {
      "key": "title",
      "selector": "input[name='title']",
      "action": "fill"
    },
    {
      "key": "employment_type",
      "selector": "select[name='employment_type']",
      "action": "select"
    },
    {
      "key": "description",
      "selector": "textarea[name='description']",
      "action": "fill"
    },
    {
      "key": "prefecture",
      "selector": "select[name='prefecture']",
      "action": "select"
    },
    {
      "key": "address",
      "selector": "input[name='address']",
      "action": "fill"
    },
    {
      "key": "station",
      "selector": "input[name='station']",
      "action": "fill"
    },
    {
      "key": "wage_type",
      "selector": "select[name='wage_type']",
      "action": "select"
    },
    {
      "key": "wage",
      "selector": "input[name='wage']",
      "action": "fill",
      "format": "int"
    },
    {
      "key": "monthly_income",
      "selector": "input[name='monthly_income']",
      "action": "fill",
      "format": "int"
    },
    {
      "key": "work_hours",
      "selector": "input[name='work_hours']",
      "action": "fill"
    },
    {
      "key": "holiday",
      "selector": "input[name='holiday']",
      "action": "fill"
    },
    {
      "key": "age_min",
      "selector": "input[name='age_min']",
      "action": "fill",
      "format": "int"
    },
    {
      "key": "age_max",
      "selector": "input[name='age_max']",
      "action": "fill",
      "format": "int"
    },
    {
      "key": "dorm",
      "selector": "input[name='dorm']",
      "action": "check",
      "value_map": {
        "あり": true,
        "なし": false
      }
    }
  ],
  "submit_mode": "draft",
  "draft_button": "button:has-text('下書き保存')",
  "publish_button": "button:has-text('公開')",
  "success_selector": "text=保存しました",
  "wait_ms_after_fill": 300,
  "timeout_ms": 10000
}
